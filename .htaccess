Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # The public pricing flow lives in the authenticated Indice application.
    # Preserve the query string so locale and campaign parameters survive.
    RewriteRule ^planes(?:\.php)?/?$ https://app.indiceapp.com/planes [R=302,L,NE]
    RewriteRule ^(?:data|logs)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^\.env(?:\..*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
