# Configuración de entorno para Índice Web
# Copia este archivo como .env y configura tus valores

# Configuración de base de datos (si es necesaria)

DB_HOST=localhost
DB_NAME=corazon_indicesaas
DB_USER=corazon_caribe
DB_PASS=Kantun.01*

; Configuración adicional (opcional)
; APP_ENV=production
; DEBUG=false

# URLs de la aplicación
APP_URL=https://app.indiceapp.com/
API_URL=https://app.indiceapp.com/

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@indiceapp.com
SMTP_PASS=
EMAIL_FROM=info@indiceapp.com
EMAIL_FROM_NAME="Equipo Índice"

# Google Analytics
GA_TRACKING_ID=

# reCAPTCHA (para formularios)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Social Media
FACEBOOK_URL=https://facebook.com/indiceapp
TWITTER_URL=https://twitter.com/indiceapp
LINKEDIN_URL=https://linkedin.com/company/indiceapp
INSTAGRAM_URL=https://instagram.com/indiceapp

# Configuración de desarrollo
DEBUG=false
LOG_LEVEL=error
