APP_URL=https://app.indiceapp.com
API_URL=https://app.indiceapp.com/api
EMAIL_FROM=info@indiceapp.com
CONTACT_TO=info@indiceapp.com
# Set a private random value (at least 32 characters), identical to APP_PLATFORM_LEAD_INGEST_SECRET.
INDICE_LEAD_INGEST_SECRET=

# Set to true only when the origin server is not directly reachable
# and all traffic comes through a trusted proxy/CDN such as Cloudflare.
TRUST_PROXY_HEADERS=false
